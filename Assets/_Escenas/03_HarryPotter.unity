  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  npcName: Dumbledore
  dialogueLine: "Ah, viajero, llegas en buen momento. Un peque\xF1o problema se nos ha escapado de las manos... o mejor dicho, de las alas. Una Snitch Dorada se liber\xF3 durante la \xFAltima pr\xE1ctica de Quidditch y anda revoloteando libre por mi oficina. \xBFSer\xEDas tan amable de atraparla antes de que rompa algo... otra vez?"
  dialoguePanel: {fileID: 1937000550}
